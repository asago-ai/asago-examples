# Copy to asago-demo/.env; this file contains no credentials.
OPENAI_BASE_URL=https://your-openai-compatible-endpoint/v1
OPENAI_API_KEY=replace-locally
ASAGO_SCENARIO_GENERATOR_MODEL_NAME=your-served-model
# Optional separate artifact generation / Garak judge model:
# REDTEAM_MODEL=your-served-model
# Garak target defaults to local Ollama with qwen2.5:14b.
# Optional Google AI Studio key (or set GOOGLE_API_KEY):
# GEMINI_API_KEY=replace-locally
# Choose LiteLLM, Ollama or Google Gemini for each role in Models & connections.
# The panel also configures the Ollama base URL and lists installed models.
